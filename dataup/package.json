{
  "name": "dataup-pipeline",
  "version": "1.0.0",
  "description": "Data Pipeline API Bank Indonesia (PIHPS) - Aceh Resilience Monitor",
  "main": "helper.js",
  "scripts": {
    "backfill": "node backfill.js",
    "daily": "node daily_update.js",
    "retry": "node retry_failed.js",
    "test": "jest --verbose --coverage",
    "test:watch": "jest --watch --verbose"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dayjs": "^1.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "helper.js",
      "lib/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
